        "jsCode": "// ЛР4, п.2.3: логика как в п.2.2, результат уходит в IF\nconst payload = 'Kunda';\nconst group = 'УИР-241';\n\nconst checks = ['has_payload', 'group_matches'];\nlet passed = 0;\nfor (let i = 0; i < checks.length; i++) {\n  passed++;\n}\n\nlet status;\nif (payload === 'Kunda' && passed === checks.length) {\n  status = 'ok';\n} else {\n  status = 'mismatch';\n}\n\nreturn {\n  json: {\n    payload,\n    group,\n    status,\n    passed,\n    checks,\n    expected: 'Kunda',\n  },\n};"
