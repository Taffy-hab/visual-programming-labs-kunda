        "jsCode": "// ЛР4, п.2.2: демонстрация базового синтаксиса JS\nconst payload = 'Kunda';\nconst group = 'УИР-241';\nlet attempts = 0;\n\n// массив\nconst topics = ['lab4/kunda/basic', 'lab4/kunda/code', 'lab4/kunda/if'];\n\n// цикл for\nconst normalized = [];\nfor (let i = 0; i < topics.length; i++) {\n  normalized.push(topics[i].toUpperCase());\n  attempts++;\n}\n\n// if / else\nlet status;\nif (payload === 'Kunda' && attempts === topics.length) {\n  status = 'ok';\n} else {\n  status = 'mismatch';\n}\n\n// объект\nconst result = {\n  payload,\n  group,\n  attempts,\n  topics,\n  normalized,\n  status,\n};\n\nconsole.log('Результат Code:', JSON.stringify(result));\n\nreturn { json: result };"
