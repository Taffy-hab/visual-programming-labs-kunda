    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// ЛР4, п.3: проверяем, что ключ kunda действительно удалён.\n// В узле Redis в n8n нет операции EXISTS, поэтому используем KEYS:\n// если ключ существует, он попадёт в список; если удалён — список пуст.\nconst items = $input\n  .all()\n  .map((i) => i.json)\n  .filter((o) => o && Object.keys(o).length > 0);\n\nconst exists = items.length > 0;\n\nreturn {\n  json: {\n    checkedKey: 'kunda',\n    exists,\n    keysFound: items,\n    conclusion: exists ? 'ключ ещё существует (EXISTS = 1)' : 'ключ удалён, EXISTS = 0',\n    student: 'Kunda',\n    group: 'УИР-241',\n  },\n};"
      },
